DATABASE_URL="postgresql://postgres:<password>@<host>:5432/postgres?schema=public"
OPENAI_API_KEY="sk-your-api-key"
OPENAI_MODEL="gpt-5.5"
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
PORT=3000

# Patient pipeline: offline defaults make no paid model/embedding requests.
PATIENT_PIPELINE_V2=true
PATIENT_AI_ENABLED=false
PATIENT_GENERATION_ENABLED=false
PATIENT_RERANK_ENABLED=false
PATIENT_COMBINED_ENABLED=true
# Optional stage overrides. Keep prices/configuration verified before enabling paid calls.
# PATIENT_GENERATION_MODEL=gpt-4.1-mini-2025-04-14
# PATIENT_VERIFICATION_MODEL=gpt-4.1-mini-2025-04-14
# PATIENT_EVALUATION_MODEL=gpt-4.1-2025-04-14
PATIENT_GENERATION_MAX_TOKENS=3072
PATIENT_VERIFICATION_MAX_TOKENS=2048
PATIENT_EVALUATION_MAX_TOKENS=8192
# A budget requires a shared ledger path; unknown model prices fail closed.
# API_BUDGET_USD=2
# API_USAGE_LEDGER_PATH=../.local/api-usage.json
# API_EVALUATION_RESERVE_USD=0.8
PATIENT_VECTOR_WEIGHT=1
PATIENT_LEXICAL_WEIGHT=1
PATIENT_RRF_K=60
PATIENT_SEARCH_CONCURRENCY=2
PATIENT_CANDIDATE_MAX=32
# Queued turns for the same session wait locally before taking a DB connection.
SESSION_LOCK_MAX=4
SESSION_QUEUE_MAX=8

# RAG settings
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS=1536      # pgvector 컬럼 vector(1536)에 맞춤
RAG_TOP_K=5
RAG_MIN_SCORE=0.42            # hybrid (vector+keyword) 최소 점수
RAG_SEMANTIC_MIN_SCORE=0.34   # semantic 하한선 — keyword boost 노이즈 차단
RAG_VECTOR_WEIGHT=0.85
RAG_KEYWORD_WEIGHT=0.15
SIMULATION_RAG_TOP_K=4
SIMULATION_RAG_MIN_SCORE=0.28          # 시맨틱 fallback 최소 점수
SIMULATION_RAG_NEAR_MISS_SCORE=0.18   # NEAR_MISS 구간 하한 — cautious LLM 답변 트리거
SIMULATION_RAG_EMBED_BATCH_SIZE=64
ENABLE_RAG_DEBUG=false
ENABLE_CONVERSATION_DEBUG=false
